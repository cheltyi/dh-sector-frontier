<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      SetSize="360 420"
                      MinSize="320 300"
                      Title="{Loc 'flying-craft-console-title'}">
    <BoxContainer Orientation="Vertical" Margin="6" SeparationOverride="4" HorizontalExpand="True">
        <Label Name="BalanceLabel" />
        <BoxContainer Name="SpawnerSection" Orientation="Vertical" SeparationOverride="2">
            <Label Text="{Loc 'flying-craft-console-spawn-header'}" StyleClasses="LabelKeyText" />
            <Label Name="SelectedSpawnerLabel" />
            <BoxContainer Name="SpawnerList" Orientation="Vertical" SeparationOverride="2" />
        </BoxContainer>
        <Label Text="{Loc 'flying-craft-console-catalog-header'}" StyleClasses="LabelKeyText" />
        <ScrollContainer VerticalExpand="True" MinSize="0 160">
            <BoxContainer Name="CatalogList" Orientation="Vertical" SeparationOverride="2" HorizontalExpand="True" />
        </ScrollContainer>
    </BoxContainer>
</controls:FancyWindow>
