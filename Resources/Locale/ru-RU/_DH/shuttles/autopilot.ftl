# Dark Haven - автопилот шаттла

# Интерфейс консоли
shuttle-console-autopilot = Автопилот
shuttle-console-build-route = Построить маршрут
shuttle-console-build-route-desc = Кликните точку на радаре, чтобы задать цель автопилота. С продвинутой платой кликните стыковочный шлюз, чтобы пристыковаться к нему.
shuttle-console-route-start = Старт
shuttle-console-route-stop = Стоп
shuttle-console-route-toggle-desc = Включить или выключить автопилот по построенному маршруту.

# Слот платы
autopilot-slot-name = Модуль автопилота

# Всплывающие сообщения
autopilot-popup-no-board = В консоль не установлена плата автопилота.
autopilot-popup-no-route = Сначала постройте маршрут.
autopilot-popup-no-console = Нет доступной консоли шаттла.
autopilot-popup-manual-control = Автопилот отключён: взято ручное управление.
autopilot-popup-ftl-interrupted = Автопилот отключён: FTL-прыжок.
autopilot-popup-no-dock-here = Здесь нет стыковочного порта — кликните прямо по порту.
autopilot-popup-arrived = Автопилот: цель достигнута.
autopilot-popup-docked = Автопилот: стыковка завершена.
autopilot-popup-fail-nomap = Автопилот: недопустимая цель.
autopilot-popup-fail-nodock = Автопилот: стыковочный шлюз недоступен.
autopilot-popup-fail-nofit = Автопилот: корабль не помещается у этого шлюза.
autopilot-popup-fail-nopath = Автопилот: маршрут до цели не найден.

# Платы автопилота
ent-AutopilotUpgradeBoardBasic = базовый модуль автопилота
    .desc = Базовая плата автопилота шаттла. Ведёт корабль по прямой из точки А в точку Б. Не обходит препятствия и не стыкуется.
ent-AutopilotUpgradeBoardImproved = улучшенный модуль автопилота
    .desc = Улучшенная плата автопилота шаттла. Прокладывает умный маршрут в обход препятствий с учётом габаритов корабля. Не стыкуется.
ent-AutopilotUpgradeBoardAdvanced = продвинутый модуль автопилота
    .desc = Продвинутая плата автопилота шаттла. Прокладывает умный маршрут в обход препятствий и может автоматически стыковаться к выбранному шлюзу.
