# Dark Haven - shuttle autopilot

# Console UI
shuttle-console-autopilot = Autopilot
shuttle-console-build-route = Build Route
shuttle-console-build-route-desc = Click a point on the radar to set the autopilot destination. With an advanced board, click a docking port to dock there.
shuttle-console-route-start = Start
shuttle-console-route-stop = Stop
shuttle-console-route-toggle-desc = Engage or disengage the autopilot toward the built route.

# Item slot
autopilot-slot-name = Autopilot Module

