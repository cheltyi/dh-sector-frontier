autopilot-popup-no-dock-here = No docking port there — click directly on a port.
autopilot-popup-arrived = Autopilot: destination reached.
autopilot-popup-docked = Autopilot: docking complete.
autopilot-popup-fail-nomap = Autopilot: invalid destination.
autopilot-popup-fail-nodock = Autopilot: docking port unavailable.
autopilot-popup-fail-nofit = Autopilot: the ship does not fit at that docking port.
autopilot-popup-fail-nopath = Autopilot: no route to the destination.
